# CampusCuts Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API Configuration
VITE_API_URL=http://localhost:3001/api/v1
VITE_API_BASE_URL=http://localhost:3001

# WebSocket Configuration (for real-time updates)
VITE_WS_URL=ws://localhost:3001

# Aptos Blockchain Configuration
VITE_APTOS_NETWORK=devnet
VITE_APTOS_NODE_URL=https://fullnode.devnet.aptoslabs.com/v1
VITE_APTOS_MODULE_ADDRESS=0x...your_deployed_module_address

# Stripe Configuration (Frontend)
# testnet = pk_test + Sui testnet defaults; mainnet = pk_live + Sui mainnet (must match backend APP_NETWORK_MODE)
# VITE_APP_NETWORK_MODE=testnet
# VITE_APP_NETWORK_MODE=mainnet

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...your_stripe_publishable_key
# Or split (with VITE_APP_NETWORK_MODE=testnet|mainnet to choose):
# VITE_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...

# Application Configuration
VITE_APP_NAME=CampusCuts
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false

# Production URLs (for deployment)
# VITE_API_URL=https://api.campuscuts.com/api/v1
# VITE_API_BASE_URL=https://api.campuscuts.com
# VITE_WS_URL=wss://api.campuscuts.com

