VITE_API_URL=http://localhost:3001/api/v1
# MoonPay: publishable key is returned from POST /v2/wallet/moonpay/prepare (set MOONPAY_* on backend).
VITE_API_ORIGIN=http://localhost:3001
# testnet | mainnet | auto (omit) — aligns Stripe publishable key + Sui RPC/USDC with backend APP_NETWORK_MODE
VITE_APP_NETWORK_MODE=auto

VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
VITE_SUI_PROVER_URL=
# Mysten public zkLogin prover (default: https://prover-v2.mystenlabs.com/v1)
# VITE_SUI_ZKLOGIN_PROVER_URL=

# Google OAuth Web client ID (implicit flow id_token). Authorized redirect URIs (exact path):
#   http://localhost:5173/web/zklogin/callback
#   http://localhost:5173/app/zklogin/callback
# Production example: https://campuscut.com/web/zklogin/callback (and /app/... if you use PWA routes)
# Backend must set GOOGLE_OAUTH_WEB_CLIENT_ID to the same client ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Optional: public site origin if it differs from window.location (default: current origin). No trailing slash.
# VITE_ZKLOGIN_REDIRECT_ORIGIN=https://campuscut.com
# Same USDC coin type as backend (testnet example — adjust per network)
VITE_SUI_USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# Optional explorer base for “View on explorer” (default derives from RPC)
# VITE_SUI_EXPLORER_BASE_URL=https://suiscan.xyz/testnet
