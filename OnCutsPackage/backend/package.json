{
  "name": "campus-cuts-backend",
  "version": "1.0.0",
  "description": "Backend API for CampusCuts decentralized barber booking platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "verify": "ts-node src/scripts/verify-integration.ts",
    "check": "npm run verify",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:sql:apple": "sh -c 'if [ -z \"$DATABASE_URL\" ]; then echo \"Set DATABASE_URL (Postgres connection string) and run:\"; echo \"  psql \\\"$DATABASE_URL\\\" -v ON_ERROR_STOP=1 -f prisma/migrations/026_apple_oauth_users.sql -f prisma/migrations/027_has_platform_password.sql\"; exit 1; fi; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/migrations/026_apple_oauth_users.sql -f prisma/migrations/027_has_platform_password.sql'",
    "postinstall": "npx prisma generate",
    "create-wallet-set": "npx ts-node scripts/create-wallet-set.ts",
    "sync-stripe-status": "npx ts-node src/scripts/sync-stripe-status.ts",
    "test:payout-relayer": "npx ts-node test-payout.ts"
  },
  "keywords": [
    "sui",
    "blockchain",
    "booking",
    "marketplace"
  ],
  "author": "CampusCuts Team",
  "license": "MIT",
  "dependencies": {
    "apple-signin-auth": "^1.7.6",
    "@aws-sdk/client-s3": "^3.700.0",
    "@mysten/sui": "^1.45.2",
    "google-auth-library": "^9.15.1",
    "@prisma/client": "^7.2.0",
    "@simplewebauthn/server": "^10.0.1",
    "apn": "^2.2.0",
    "aws-sdk": "^2.1505.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.66.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "form-data": "^4.0.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "ipfs-http-client": "^56.0.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "redis": "^4.6.8",
    "sharp": "^0.32.5",
    "socket.io": "^4.8.1",
    "stripe": "^14.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/luxon": "^3.4.2",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/redis": "^4.0.11",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.2.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
