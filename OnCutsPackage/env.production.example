# CampusCuts Production Environment Variables
# Copy this to .env.prod and fill in your actual values

# ═══════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3001
BASE_URL=https://api.campuscuts.com
FRONTEND_URL=https://app.campuscuts.com

# ═══════════════════════════════════════════════════════════
# DATABASE (Auto-configured by Railway)
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/campuscuts?sslmode=require

# ═══════════════════════════════════════════════════════════
# REDIS (Optional - Upstash free tier)
# ═══════════════════════════════════════════════════════════
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ═══════════════════════════════════════════════════════════
# JWT SECRETS
# Generate with: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ═══════════════════════════════════════════════════════════
# APTOS BLOCKCHAIN (MAINNET)
# ═══════════════════════════════════════════════════════════
APTOS_NETWORK=mainnet
APTOS_NODE_URL=https://fullnode.mainnet.aptoslabs.com/v1
APTOS_PLATFORM_PRIVATE_KEY=0xYOUR_64_CHAR_PRIVATE_KEY
APTOS_PLATFORM_ADDRESS=0xYOUR_64_CHAR_ADDRESS
APTOS_MODULE_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ═══════════════════════════════════════════════════════════
# GAS WALLET
# Use separate wallet or same as platform for testing
# ═══════════════════════════════════════════════════════════
GAS_WALLET_PRIVATE_KEY=0xYOUR_64_CHAR_PRIVATE_KEY

# ═══════════════════════════════════════════════════════════
# STRIPE (LIVE MODE)
# Get from: https://dashboard.stripe.com/apikeys
# ═══════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_live_51CHARS
STRIPE_PUBLISHABLE_KEY=pk_live_51CHARS
STRIPE_WEBHOOK_SECRET=whsec_32CHARS

# ═══════════════════════════════════════════════════════════
# CIRCLE (USDC - PRODUCTION)
# Sign up: https://www.circle.com/en/developers
# ═══════════════════════════════════════════════════════════
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY
CIRCLE_API_URL=https://api.circle.com
CIRCLE_WALLET_ID=YOUR_CIRCLE_WALLET_ID

# ═══════════════════════════════════════════════════════════
# IPFS / PINATA
# Sign up: https://app.pinata.cloud
# ═══════════════════════════════════════════════════════════
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_API_KEY=YOUR_PINATA_SECRET
PINATA_JWT=YOUR_PINATA_JWT
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ═══════════════════════════════════════════════════════════
# EMAIL SERVICE (SendGrid Recommended)
# Or use Gmail with app password
# ═══════════════════════════════════════════════════════════
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY

# ═══════════════════════════════════════════════════════════
# OPENAI (for AI Worker)
# Get from: https://platform.openai.com/api-keys
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY

# ═══════════════════════════════════════════════════════════
# SECURITY
# Generate with: openssl rand -hex 64
# ═══════════════════════════════════════════════════════════
CUSTODIAL_ENCRYPTION_SECRET=CHANGE_ME_128_CHAR_RANDOM_STRING

# ═══════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════
ALLOWED_ORIGINS=https://app.campuscuts.com,https://campuscuts.com

# ═══════════════════════════════════════════════════════════
# PLATFORM SETTINGS
# ═══════════════════════════════════════════════════════════
PLATFORM_FEE_PERCENTAGE=5

# ═══════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=750

# ═══════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=info



