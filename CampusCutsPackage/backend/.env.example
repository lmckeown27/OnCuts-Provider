# Single switch: testnet (Stripe test + Sui testnet defaults) vs mainnet (Stripe live + Sui mainnet defaults).
# Omit or auto = no defaults from this; set SUI_RPC_URL / SUI_USDC_COIN_TYPE / STRIPE_* explicitly.
# STRIPE_MODE=test|live overrides Stripe key choice; when STRIPE_MODE=auto, this maps testnet→test keys, mainnet→live.
APP_NETWORK_MODE=auto

# Stripe — see src/config/stripe.ts
# Generic (single dashboard):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: split test + live (aliases: STRIPE_LIVE_SECRET_KEY / STRIPE_TEST_SECRET_KEY, STRIPE_LIVE_WEBHOOK_SECRET / STRIPE_TEST_WEBHOOK_SECRET)
STRIPE_SECRET_KEY_LIVE=
STRIPE_SECRET_KEY_TEST=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
# auto | live | test — auto picks key from NODE_ENV + sk_* env vars; webhook API uses event.livemode
STRIPE_MODE=auto

# Bridge + Sui
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.example
SUI_RPC_URL=
# Mainnet native USDC type (omit to use default in src/config/blockchain.ts)
SUI_USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ad5531876580039906648354972135f29979d9744::usdc::USDC
# Treasury wallet (must match the key below / holds merged USDC)
SUI_TREASURY_ADDRESS=
# Revenue wallet for 20% platform leg (optional; defaults to SUI_TREASURY_ADDRESS)
SUI_PLATFORM_PAYOUT_ADDRESS=
# Primary treasury private key (suiprivkey or hex). Used for gas when GAS_SPONSOR_SECRET unset; also signs USDC if SUI_TREASURY_SIGNER_SECRET unset.
SUI_TREASURY_SECRET=
# Optional: separate key that signs treasury USDC only (else SUI_TREASURY_SECRET / gas sponsor chain).
SUI_TREASURY_SIGNER_SECRET=
# Optional: dedicated gas wallet when SUI_SPONSOR_API_URL is unset (else SUI_TREASURY_SECRET → SUI_TREASURY_SIGNER_SECRET).
GAS_SPONSOR_SECRET=
# Optional: HTTP gas station returns sponsorSignature for same tx bytes as treasury (e.g. Shinami)
SUI_SPONSOR_API_URL=
SUI_SPONSOR_API_KEY=
# true = checkout.session.completed enqueues BullMQ process-payout (merge+split relayer); needs REDIS_URL
SUI_DIY_RELAYER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
SUI_PROVER_URL=
# Native zkLogin: deterministic salt SHA256(MASTER_SEED + Google `sub`). Legacy: SALT_SERVICE_SECRET if MASTER_SEED unset.
MASTER_SEED=
# SALT_SERVICE_SECRET=

# Must match web `VITE_GOOGLE_OAUTH_CLIENT_ID` (Google OAuth Web client ID) for id_token verification.
GOOGLE_OAUTH_WEB_CLIENT_ID=

# App URLs (Stripe Checkout redirects)
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
